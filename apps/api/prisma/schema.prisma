datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  publicKey String   @unique @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotes Quote[]
  orders Order[]

  @@map("users")
}

model Quote {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  sourceAsset       Json     @map("source_asset")
  destinationAsset  Json     @map("destination_asset")
  sourceAmount      String   @map("source_amount")
  destinationAmount String   @map("destination_amount")
  minimumReceived   String   @map("minimum_received")
  slippageTolerance Float    @map("slippage_tolerance")
  priceImpact       Float    @map("price_impact")
  networkFee        String   @map("network_fee")
  platformFee       String   @map("platform_fee")
  path              Json
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([expiresAt])
  @@map("quotes")
}

model Order {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  status            String
  sourceAsset       Json     @map("source_asset")
  destinationAsset  Json     @map("destination_asset")
  sourceAmount      String   @map("source_amount")
  destinationAmount String?  @map("destination_amount")
  quoteId           String?  @map("quote_id")
  stellarTxHash     String?  @map("stellar_tx_hash")
  externalId        String?  @map("external_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id])
  quote  Quote?       @relation(fields: [quoteId], references: [id])
  events OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([stellarTxHash])
  @@map("orders")
}

model OrderEvent {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}
