# LumenFlow – API Environment Variables
# Copy this file to .env and fill in values for local development.
# NEVER commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://lumenflow:lumenflow_dev_password@localhost:5432/lumenflow_dev

# Redis connection string
REDIS_URL=redis://localhost:6379

# Stellar – TESTNET ONLY. Never use mainnet values in development.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Anchor configuration
ANCHOR_HOME_DOMAIN=your-anchor-home-domain.example.com
ANCHOR_SIGNING_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SEP-10 challenge signing key (use a KMS/HSM in production – never a raw secret here)
SEP10_SERVER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# KYC provider (mock in development)
KYC_PROVIDER_API_KEY=mock_kyc_api_key_replace_me

# Payout provider (mock in development)
PAYOUT_PROVIDER_API_KEY=mock_payout_api_key_replace_me

# Bridge provider (mock in development)
BRIDGE_PROVIDER_API_KEY=mock_bridge_api_key_replace_me

# JWT session secret (generate a strong random value for staging/production)
JWT_SECRET=replace_me_with_a_strong_random_secret

# Webhook signature verification secret
WEBHOOK_SIGNING_SECRET=replace_me_with_a_strong_random_secret

# Error tracking (optional)
SENTRY_DSN=
