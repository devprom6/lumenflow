{
  "name": "@lumenflow/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:studio": "prisma studio",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@lumenflow/anchor-client": "workspace:*",
    "@lumenflow/bridge-adapters": "workspace:*",
    "@lumenflow/quote-engine": "workspace:*",
    "@lumenflow/shared-types": "workspace:*",
    "@lumenflow/stellar": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^11.10.0",
    "@types/pg": "^8.23.1",
    "bullmq": "6.3.15",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lumenflow/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.3.1",
    "@types/express": "^5.0.0",
    "@types/node": "22.15.17",
    "@types/passport-jwt": "4.0.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
