    "@sentry/node": "^11.10.0",
    "bullmq": "6.3.15",
    "ioredis": "6.0.0",
    "prom-client": "^15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lumenflow/config": "workspace:*",
    "@types/node": "22.15.17",
    "prisma": "7.10.0",
    "ts-node-dev": "2.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
