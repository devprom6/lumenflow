# LumenFlow – Web App Environment Variables
# Copy this file to .env.local and fill in values for local development.
# NEVER commit .env.local.

# Base URL of the LumenFlow API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stellar network to use: TESTNET only during development
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Horizon REST API endpoint
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar RPC endpoint (for Soroban / fee estimation)
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
