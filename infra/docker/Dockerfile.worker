# ── LumenFlow Worker (BullMQ consumer) ──────────────────────────────────
# Multi-stage build for the background worker service

FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

# ── Stage 1: Install all dependencies ──────────────────────────────────
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.scripts.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/
RUN pnpm install --frozen-lockfile

# ── Stage 2: Build ──────────────────────────────────────────────────────
FROM deps AS builder
RUN pnpm --filter @lumenflow/worker build

# ── Stage 3: Production image ───────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

RUN groupadd --gid 1001 lumenflow && \
    useradd --uid 1001 --gid lumenflow --shell /bin/bash lumenflow

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/package.json ./package.json

USER lumenflow
EXPOSE 9102

CMD ["node", "apps/worker/dist/main.js"]
