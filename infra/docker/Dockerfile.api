# ── LumenFlow API (NestJS) ──────────────────────────────────────────────
# Multi-stage build: install → build workspace packages → build API → prune to prod

FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

# ── Stage 1: Install all dependencies ──────────────────────────────────
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.scripts.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
RUN pnpm install --frozen-lockfile

# ── Stage 2: Build workspace packages first, then the API ──────────────
FROM deps AS builder
# Build in dependency order: stellar before quote-engine (which imports stellar)
RUN pnpm --filter @lumenflow/shared-types build \
 && pnpm --filter @lumenflow/stellar build \
 && pnpm --filter @lumenflow/quote-engine build \
 && pnpm --filter @lumenflow/bridge-adapters build \
 && pnpm --filter @lumenflow/anchor-client build
RUN pnpm --filter @lumenflow/api exec prisma generate
RUN pnpm --filter @lumenflow/api build

# ── Stage 3: Production image ───────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

RUN groupadd --gid 1001 lumenflow && \
    useradd --uid 1001 --gid lumenflow --shell /bin/bash lumenflow

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/package.json ./package.json

USER lumenflow
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/main.js"]
