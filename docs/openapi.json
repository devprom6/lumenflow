{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Checks connectivity to PostgreSQL database, Redis instance, and Stellar Horizon Testnet.",
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "System is healthy or running with fallbacks."
          },
          "503": {
            "description": "Core system component is down."
          }
        },
        "summary": "System health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/auth/challenge": {
      "post": {
        "description": "Generates an unsigned challenge transaction for the wallet to sign.",
        "operationId": "AuthController_challenge",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Challenge transaction XDR and network passphrase returned."
          },
          "400": {
            "description": "Invalid public key format."
          }
        },
        "summary": "Request SEP-10 wallet challenge",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/verify": {
      "post": {
        "description": "Verifies the wallet signature, upserts the user, and issues a session JWT.",
        "operationId": "AuthController_verify",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Session JWT and authenticated user info returned."
          },
          "401": {
            "description": "Invalid signature, expired challenge, or untrusted signer."
          }
        },
        "summary": "Verify signed SEP-10 challenge",
        "tags": [
          "Auth"
        ]
      }
    },
    "/assets": {
      "get": {
        "description": "Returns all Stellar testnet assets supported by LumenFlow.",
        "operationId": "AssetsController_getAssets",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of supported assets with issuer and metadata."
          }
        },
        "summary": "List supported assets",
        "tags": [
          "Assets"
        ]
      }
    },
    "/swap/quote": {
      "post": {
        "description": "Calculates the best route across order-book DEX and liquidity pools with fee breakdown and expiry.",
        "operationId": "SwapController_getQuote",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Live swap quote returned."
          },
          "400": {
            "description": "Invalid asset or amount parameter."
          }
        },
        "summary": "Get a swap quote",
        "tags": [
          "Swap"
        ]
      }
    },
    "/swap/build": {
      "post": {
        "description": "Generates an unsigned Stellar transaction XDR (including changeTrust if needed). Non-custodial: user signs.",
        "operationId": "SwapController_build",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Unsigned transaction XDR ready for wallet signing."
          },
          "400": {
            "description": "Quote expired or insufficient reserves."
          }
        },
        "summary": "Build an unsigned swap transaction",
        "tags": [
          "Swap"
        ]
      }
    },
    "/swap/submit": {
      "post": {
        "description": "Submits the user-signed transaction to Stellar Horizon and updates the order status to COMPLETED.",
        "operationId": "SwapController_submit",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Transaction submitted and confirmed on ledger."
          },
          "400": {
            "description": "Invalid signature, expired quote, or submission failed."
          }
        },
        "summary": "Submit a signed swap transaction",
        "tags": [
          "Swap"
        ]
      }
    },
    "/orders/{id}": {
      "get": {
        "description": "Fetches an order by ID including its immutable append-only state transition ledger.",
        "operationId": "OrdersController_getOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Order UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details with event history."
          },
          "404": {
            "description": "Order not found."
          }
        },
        "summary": "Get order details and append-only event history",
        "tags": [
          "Orders"
        ]
      }
    },
    "/transactions": {
      "get": {
        "description": "Lists all swap, bridge, and offramp orders for the user.",
        "operationId": "OrdersController_getTransactions",
        "parameters": [
          {
            "name": "userId",
            "required": false,
            "in": "query",
            "description": "Filter by user ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of user transactions."
          }
        },
        "summary": "List user transaction history",
        "tags": [
          "Orders"
        ]
      }
    },
    "/offramp/quote": {
      "post": {
        "operationId": "OfframpController_getQuote",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Guaranteed offramp quote"
          },
          "400": {
            "description": "Invalid amount or currency"
          }
        },
        "summary": "Request offramp rate, fee breakdown, and rate-lock",
        "tags": [
          "Offramp"
        ]
      }
    },
    "/offramp/orders": {
      "post": {
        "operationId": "OfframpController_createOrder",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Order created with interactive withdrawal window"
          },
          "400": {
            "description": "Quote expired or limits exceeded"
          },
          "403": {
            "description": "Blocked by compliance screening"
          }
        },
        "summary": "Create offramp order and initiate interactive withdrawal",
        "tags": [
          "Offramp"
        ]
      }
    },
    "/offramp/orders/{id}": {
      "get": {
        "operationId": "OfframpController_getStatus",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order status details"
          },
          "404": {
            "description": "Order not found"
          }
        },
        "summary": "Get offramp order status",
        "tags": [
          "Offramp"
        ]
      }
    },
    "/bridge/routes": {
      "get": {
        "operationId": "BridgeController_getRoutes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Supported bridge routes"
          }
        },
        "summary": "Get list of supported cross-chain routes",
        "tags": [
          "Bridge"
        ]
      }
    },
    "/bridge/quote": {
      "post": {
        "operationId": "BridgeController_getQuote",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Bridge quote generated successfully"
          },
          "400": {
            "description": "Invalid route, amount below min or above max"
          },
          "403": {
            "description": "Route paused by safeguard kill-switch"
          }
        },
        "summary": "Request cross-chain bridge quote with fee estimate",
        "tags": [
          "Bridge"
        ]
      }
    },
    "/bridge/transfer": {
      "post": {
        "operationId": "BridgeController_initiateTransfer",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Unsigned transfer created for local wallet signing"
          },
          "400": {
            "description": "Quote expired or invalid"
          },
          "403": {
            "description": "Safeguard triggered"
          }
        },
        "summary": "Initiate bridge transfer and construct unsigned transaction",
        "tags": [
          "Bridge"
        ]
      }
    },
    "/bridge/transfer/{id}": {
      "get": {
        "operationId": "BridgeController_getTransfer",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bridge transfer status details"
          },
          "404": {
            "description": "Transfer or order not found"
          }
        },
        "summary": "Get bridge transfer and on-chain progress status",
        "tags": [
          "Bridge"
        ]
      }
    },
    "/bridge/safeguards/kill-switch": {
      "post": {
        "operationId": "BridgeController_toggleKillSwitch",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Safeguard updated successfully"
          }
        },
        "summary": "Toggle route or provider kill switch",
        "tags": [
          "Bridge"
        ]
      }
    },
    "/bridge/safeguards/limits": {
      "post": {
        "operationId": "BridgeController_configureLimits",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Route limits updated successfully"
          }
        },
        "summary": "Configure per-route min and max transfer limits",
        "tags": [
          "Bridge"
        ]
      }
    },
    "/webhooks/bridge": {
      "post": {
        "operationId": "WebhooksController_bridgeCallback",
        "parameters": [
          {
            "name": "x-webhook-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bridge webhook processed idempotently"
          },
          "401": {
            "description": "Invalid HMAC signature"
          }
        },
        "summary": "Cross-chain Bridge provider transfer status callback",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/webhooks/anchor": {
      "post": {
        "operationId": "WebhooksController_anchorCallback",
        "parameters": [
          {
            "name": "x-webhook-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook processed idempotently"
          },
          "401": {
            "description": "Invalid HMAC signature"
          }
        },
        "summary": "Stellar Anchor SEP-24 status callback",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/webhooks/payout": {
      "post": {
        "operationId": "WebhooksController_payoutCallback",
        "parameters": [
          {
            "name": "x-webhook-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook processed idempotently"
          },
          "401": {
            "description": "Invalid HMAC signature"
          }
        },
        "summary": "Fiat Payout rail status callback",
        "tags": [
          "Webhooks"
        ]
      }
    }
  },
  "info": {
    "title": "LumenFlow API",
    "description": "Stellar-based platform for non-custodial swaps, cross-chain bridging, and crypto offramps.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "SEP-10 wallet authentication and challenge verification"
    },
    {
      "name": "Swap",
      "description": "Live quotes, unsigned transaction building, and submission"
    },
    {
      "name": "Assets",
      "description": "Supported Stellar assets on testnet"
    },
    {
      "name": "Orders",
      "description": "Order status tracking and transaction history"
    },
    {
      "name": "Bridge",
      "description": "Cross-chain bridge stubs (external providers)"
    },
    {
      "name": "Offramp",
      "description": "Anchor/payout offramp stubs (external providers)"
    },
    {
      "name": "Webhooks",
      "description": "Provider webhook stubs"
    },
    {
      "name": "Health",
      "description": "System and external service connectivity health check"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "Enter session JWT obtained from /auth/verify",
        "in": "header"
      }
    },
    "schemas": {}
  }
}